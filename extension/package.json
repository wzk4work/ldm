{
  "name": "ldm-browser-extension",
  "version": "0.9.0",
  "private": true,
  "description": "LDM browser integration (Chromium + Firefox, Manifest V3)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:store": "node build.mjs --store",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node build.mjs --tests && node --test dist-test/",
    "check": "npm run typecheck && npm test && npm run build && npm run build:store"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "@types/node": "^20.11.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
